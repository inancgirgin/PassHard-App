{
  "expo": {
    "name": "PassHard",
    "slug": "PassHard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logosu.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logosu.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.megaly.PassHard",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PassHard, güvenli alan kilidi özelliğini kullanabilmek için konumunuza ihtiyaç duyar.",
        "NSFaceIDUsageDescription": "Giriş güvenliği için FaceID kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logosu.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.megaly.PassHard",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Güvenli alan kilidi özelliğini kullanabilmek için konumunuza ihtiyaç duyar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6ba36a03-2baf-4ddb-8ae7-5ff31e6a6ce2"
      }
    }
  }
}
